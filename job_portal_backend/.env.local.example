# Django local development
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=local-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL 16 + pgvector (docker-compose db service is exposed on localhost)
DB_NAME=job_portal
DB_USER=job_portal
DB_PASSWORD=job_portal
DB_HOST=localhost
DB_PORT=5432

# Auth
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
GOOGLE_CLIENT_ID=

# QStash CLI Dev Mode
QSTASH_DEV=true
QSTASH_URL=http://127.0.0.1:8080
BACKEND_PUBLIC_URL=http://127.0.0.1:8000

# Cloudflare R2 development bucket (private)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_SIGNED_URL_TTL_SECONDS=300

# Gemini
GEMINI_API_KEY=
GEMINI_PARSER_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_TIMEOUT_MS=10000
TASK_PROCESSING_LEASE_SECONDS=60

# SMTP (only required locally when testing notifications)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=IT Job Portal <no-reply@example.test>

MAX_RESUME_SIZE_BYTES=5242880
MAX_JD_SIZE_BYTES=5242880
