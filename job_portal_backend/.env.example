# Django
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=*

# Database (docker-compose: db service on 0.0.0.0:5432)
DB_NAME=job_portal
DB_USER=job_portal
DB_PASSWORD=job_portal
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=

# CORS (comma-separated origins)
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Background worker
REDIS_URL=redis://localhost:6379/0

# Gemini AI
GEMINI_API_KEY=
EMBEDDING_TIMEOUT_MS=10000
GEMINI_PARSER_MODEL=gemini-3.6-flash

# Candidate CV upload (10 MB)
MAX_RESUME_SIZE_BYTES=52428800

# Employer JD upload (10 MB)
MAX_JD_SIZE_BYTES=52428800

# Gmail SMTP (use a Google App Password, not the account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=20
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_MINUTES=5
