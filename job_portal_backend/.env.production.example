DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=trangdeptraiok
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com
CSRF_TRUSTED_ORIGINS=https://www.example.com,https://api.example.com
BACKEND_PUBLIC_URL=https://api.example.com

# Prefer Render's internal PostgreSQL URL.
DATABASE_URL=

# Upstash Redis must retain TLS certificate verification.
REDIS_URL=rediss://default:password@host:6379

QSTASH_DEV=false
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_SIGNED_URL_TTL_SECONDS=300

GEMINI_API_KEY=
GEMINI_PARSER_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_TIMEOUT_MS=60000
TASK_PROCESSING_LEASE_SECONDS=60
GOOGLE_CLIENT_ID=

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=IT Job Portal <no-reply@example.com>

# Enable only after HTTPS and domain routing are verified.
ENABLE_HTTPS_REDIRECT=false
ENABLE_HSTS=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# One-time Render demo seed. Set true for one deploy, then remove or set false.
RUN_RENDER_SEED=false
RUN_REBUILD_EMBEDDINGS=false
SEED_ADMIN_EMAIL=admin.demo@jobportal.local
SEED_ADMIN_PASSWORD=
SEED_EMPLOYER_EMAIL=employer.demo@jobportal.local
SEED_EMPLOYER_PASSWORD=
SEED_CANDIDATE_PASSWORD=
MAX_RESUME_SIZE_BYTES=5242880
MAX_JD_SIZE_BYTES=5242880
